# Copy to .env and edit.  `.env` is git-ignored: NEVER commit real values.
# On Vercel set the same names under Project → Settings → Environment Variables.

# ---- Core ----------------------------------------------------------------
# development | production
APP_ENV=development
# REQUIRED in production (the app refuses to start without it) and must be the
# SAME on every serverless instance. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# SQLite for local development. Production/Vercel: PostgreSQL (Neon, Supabase, Vercel Postgres...).
# postgres:// and postgresql:// URLs are accepted and converted to the psycopg3 driver.
#   postgresql://user:password@host:5432/wahj?sslmode=require
DATABASE_URL=sqlite:///instance/wahj.db
DEFAULT_CURRENCY=USD
# Time zone used to show/enter workshop and booking times (stored in UTC).
ACADEMY_TIMEZONE=Asia/Riyadh
# Show the "demo edition / fictional content" strip on public pages (1/0).
SHOW_SAMPLE_NOTICE=1
# Public https origin, used in e-mailed links (no trailing slash), e.g. https://academy.example.com
PUBLIC_BASE_URL=
# Comma-separated host names the app will answer to (blocks forged Host headers), e.g. academy.example.com
TRUSTED_HOSTS=

# ---- Security ------------------------------------------------------------
# Rate-limit storage. memory:// is per-process: fine for dev, USELESS on Vercel/multi-worker.
# Production: Redis, e.g. redis://localhost:6379  or  rediss://default:password@host:6379 (Upstash etc.)
RATELIMIT_STORAGE_URI=memory://
# Number of reverse proxies in front of the app (nginx = 1). Vercel = 1. 0 = none.
# Only set this when a proxy really sets X-Forwarded-* headers.
TRUSTED_PROXY_COUNT=0
# Force every staff account to enrol TOTP two-factor authentication (default: on in production).
REQUIRE_STAFF_2FA=

# ---- E-mail (SMTP) --------------------------------------------------------
# Leave MAIL_SERVER empty to run without sending: messages are then only kept in the
# owner-visible outbox (Control panel → E-mail outbox).
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=1          # STARTTLS on 587
MAIL_USE_SSL=0          # implicit TLS on 465 (then set MAIL_USE_TLS=0)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=              # e.g. "WAHJ Academy <no-reply@academy.example.com>"
MAIL_ADMIN_TO=          # staff inbox for contact/booking/payment alerts
# Require confirmed e-mail before enrolling/booking. Default: on when MAIL_SERVER+MAIL_FROM are set.
REQUIRE_EMAIL_VERIFICATION=

# ---- Initial owner account (used ONCE by `flask create-owner`) ------------
OWNER_EMAIL=
OWNER_NAME=Academy Owner
# Optional. If empty, `flask create-owner` prompts for the password without
# echoing it (recommended). If set, it is used once and the owner is forced to
# change it at first login. Minimum 12 characters. Remove it from .env after use.
OWNER_INITIAL_PASSWORD=

# ---- Tests only (never in production) ---------------------------------------
# TEST_DATABASE_URL=postgresql+psycopg://user@localhost/wahj_test
# TEST_REDIS_URL=redis://localhost:6379
