# Copy to .env and edit.  `.env` is git-ignored: NEVER commit real values.

# ---- Core ----------------------------------------------------------------
# development | production
APP_ENV=development
# Required in production (app refuses to start without it). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# SQLite for development; PostgreSQL for production, e.g.
#   postgresql+psycopg://user:password@localhost:5432/ufuqia
# (install the driver first: pip install "psycopg[binary]")
DATABASE_URL=sqlite:///ufuqia.db
DEFAULT_CURRENCY=USD

# ---- Security ------------------------------------------------------------
# Rate-limit storage. memory:// is per-process (fine for dev / single worker).
# For several workers use Redis, e.g. redis://localhost:6379 (pip install redis)
RATELIMIT_STORAGE_URI=memory://
# Number of reverse proxies in front of the app (nginx = 1). 0 = none.
# Only set this when a proxy really sets X-Forwarded-* headers.
TRUSTED_PROXY_COUNT=0

# ---- Initial owner account (used ONCE by `flask create-owner`) ------------
OWNER_EMAIL=
OWNER_NAME=Academy Owner
# Optional. If empty, `flask create-owner` prompts for the password without
# echoing it (recommended). If set, it is used once and the owner is forced to
# change it at first login. Minimum 12 characters. Remove it from .env after use.
OWNER_INITIAL_PASSWORD=
